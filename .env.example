OPENAI_API_KEY=
TAVILY_API_KEY=
JEV_API_KEY=
AUTH_SECRET=
DATA_DIR=
# Source of truth: Railway Postgres on project `astronotes`
# (Patrick O’Donnell workspace). The API service reads DATABASE_URL from
# ${{Postgres.DATABASE_URL}}. Do not set this on Vercel; the frontend uses
# the Railway API. SUPABASE_DB_URL is an unused local fallback only.
DATABASE_URL=
SUPABASE_DB_URL=
FRONTEND_ORIGIN=https://astronotes.ai
COOKIE_DOMAIN=.astronotes.ai
# Leave empty so the browser calls same-origin /api on astronotes.ai.
# proxy.ts rewrites those requests to the Railway API.
NEXT_PUBLIC_API_URL=
API_REWRITE_URL=https://astronotes-production-1e50.up.railway.app
API_INTERNAL_URL=https://astronotes-production-1e50.up.railway.app
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_CREDIT_PACK=20
# REST API key from the Companies House developer hub (client type "API key", not Web).
COMPANIES_HOUSE_API_KEY=
CONGRESS_GOV_API_KEY=
FEC_API_KEY=
PATENTSVIEW_API_KEY=
SAM_API_KEY=
GITHUB_TOKEN=
OPENSANCTIONS_API_KEY=
